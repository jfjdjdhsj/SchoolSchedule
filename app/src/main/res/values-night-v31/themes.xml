<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SchoolSchedule" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FF121212</item>
        <!-- 深色模式：深色背景上使用浅色状态栏 / 导航栏图标 -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- API 31+ 启动画面：不显示应用图标，仅纯色背景 -->
        <item name="android:windowSplashScreenBackground">#FF121212</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
